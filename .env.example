WG_USER=your@email.address
WG_PASS=your_waterguru_password

# Optional: lat/lon for the 5-day swim-weather forecast (National Weather Service,
# US locations only). Look yours up at https://www.latlong.net/ or via zip code.
WX_LAT=
WX_LON=

# ---------------------------------------------------------------------------
# Alerting - configure any, all, or none of these. Each channel is independent.
# ---------------------------------------------------------------------------

# Push via https://ntfy.sh when status goes RED. Pick a random, hard-to-guess
# topic name (anyone who knows it can read your alerts, ntfy.sh topics aren't
# access-controlled) and subscribe to it in the ntfy app.
NTFY_TOPIC=

# Push via https://pushover.net. Both values are required to enable it:
#   PUSHOVER_USER_KEY  - your 30-char user key, shown on the Pushover dashboard
#   PUSHOVER_API_TOKEN - create an Application at pushover.net/apps/build
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
# Optional Pushover tuning:
#   PUSHOVER_DEVICE   - send to one device only (default: all your devices)
#   PUSHOVER_PRIORITY - -2 silent, -1 quiet, 0 normal, 1 high (default), 2 requires ack
#   PUSHOVER_SOUND    - e.g. siren, falling, none  (https://pushover.net/api#sounds)
#   PUSHOVER_RETRY / PUSHOVER_EXPIRE - seconds, only used when priority is 2
PUSHOVER_DEVICE=
PUSHOVER_PRIORITY=
PUSHOVER_SOUND=

# Desktop notifications (macOS osascript / Linux notify-send). On by default;
# set to 0 for a headless server. Linux notifications are skipped automatically
# when there's no graphical session, so cron on a server stays quiet regardless.
DESKTOP_NOTIFY=1

# ---------------------------------------------------------------------------
# Local LLM (Ollama) - both AI features degrade to rule-based output if these
# aren't reachable, so leaving all of this unset still gives a working dashboard.
# ---------------------------------------------------------------------------

# Ollama base URL. Point it at another machine to run the pipeline on a Linux
# box while the models live on a Mac (start that Mac's Ollama with
# OLLAMA_HOST=0.0.0.0 so it listens beyond localhost).
OLLAMA_HOST=http://localhost:11434

# Which model answers which prompt. See the model-sizing table in the README, or
# run `python bench_models.py` to time candidates on your own hardware.
#   trend   - summarizing 14 days of numbers; a small model is genuinely fine
#   advisor - day-by-day swim verdicts + heater advice; wants real judgment
# gemma3:12b is the recommended advisor on a 32 GB Mac: ~8 GB resident, several
# times faster than a 32b model, and leaves room for other models to stay loaded.
# (If these are unset entirely the code defaults to llama3.2:3b / qwen2.5:32b,
# which is what earlier versions of this project hardcoded.)
WG_TREND_MODEL=llama3.2:3b
WG_ADVISOR_MODEL=gemma3:12b

# Seconds to wait on a generation before falling back to rule-based output.
# Raise it if you're running a large model on a memory-bandwidth-limited machine.
WG_LLM_TIMEOUT=
